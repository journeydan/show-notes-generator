import json, urllib.request

with open("/Users/danielbader/Documents/Apps/show-notes-generator/show-notes-generator/craft_api_key.txt") as f:
    key = f.read().strip()

MCP_URL = "https://mcp.craft.do/links/7foILXddSEb/mcp"

def mcp(method, params=None):
    payload = {"jsonrpc": "2.0", "method": method, "id": 1}
    if params: payload["params"] = params
    req = urllib.request.Request(MCP_URL, data=json.dumps(payload).encode(),
        headers={"Content-Type":"application/json","Accept":"application/json, text/event-stream",
            "User-Agent":"Hermes/1.0","Authorization":"Bearer "+key}, method="POST")
    with urllib.request.urlopen(req, timeout=20) as resp:
        for line in resp.read().decode().split('\n'):
            if line.startswith('data: '): return json.loads(line[6:])
    return None

